# Copia questo file in .env.local (che non va mai nella repo) e inserisci i valori del progetto
# Supabase: Dashboard Supabase > Project Settings > API.
# La chiave "publishable" (pubblica) è fatta per stare nell'app: NON usare mai la chiave "secret".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
